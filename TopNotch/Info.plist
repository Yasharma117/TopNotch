<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hides the Dock icon — the notch panel IS the UI -->
	<key>LSUIElement</key>
	<true/>
	<!-- Export compliance: app uses only exempt encryption (standard HTTPS/TLS),
	     so no French/US export docs are required. Avoids the per-upload prompt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>TopNotch needs microphone access to record audio while you read your script.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>TopNotch uses speech recognition to automatically scroll the teleprompter as you speak, keeping perfect pace with your voice.</string>
</dict>
</plist>
